# ExperimentFlow Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (MySQL primary; falls back automatically to SQLite if MySQL is unreachable or unconfigured)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=experimentflow
# Set DB_URL explicitly if desired, e.g. mysql+pymysql://user:pass@localhost:3306/experimentflow
# DB_URL=sqlite:///./experimentflow.db

# Local AI Provider (Ollama or OpenAI-compatible local runtime; uses algorithmic heuristic search when unavailable)
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3:latest
LOCAL_AI_TIMEOUT=15

# Upload storage
UPLOAD_DIR=./uploads
DATASETS_DIR=../datasets
